  "strings": {
    "Any plugin calls the toast service with a message and style.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any plugin calls the toast service with a message and style."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何插件都可携带消息与样式调用 toast 服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何外掛程式都可攜帶訊息與樣式呼叫 toast 服務。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "任何外掛程式都可攜帶訊息與樣式呼叫 toast 服務。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "任何外掛程式都可攜帶訊息與樣式呼叫 toast 服務。"
          }
        }
      }
    },
