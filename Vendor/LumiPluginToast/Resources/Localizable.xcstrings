    "Rapid-fire messages refresh the current toast instead of stacking.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapid-fire messages refresh the current toast instead of stacking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高频消息刷新当前 toast，而不是堆叠成串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高頻訊息重新整理目前 toast，而不是堆疊成串。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "高頻訊息重新整理目前 toast，而不是堆疊成串。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "高頻訊息重新整理目前 toast，而不是堆疊成串。"
          }
        }
      }
    },
