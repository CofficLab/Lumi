    "Any plugin can register its own commands into the palette.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any plugin can register its own commands into the palette."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何插件都能把自己的命令注册进面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何插件都能把自己的命令註冊進面板。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "任何插件都能把自己的命令註冊進面板。"
