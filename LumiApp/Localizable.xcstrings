    "Lumi needs at least %@ of free disk space to run. Only %@ remains. Low disk space can cause plugin startup or data write failures; free up space soon." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumi needs at least %@ of free disk space to run. Only %@ remains. Low disk space can cause plugin startup or data write failures; free up space soon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumi 至少需要 %@ 的可用磁盘空间才能启动，当前只剩 %@。空间不足会导致插件启动失败或数据写入失败，请尽快清理磁盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumi 至少需要 %@ 的可用磁盤空間才能啓動，當前只剩 %@。空間不足會導致插件啓動失敗或數據寫入失敗，請盡快清理磁盤。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumi 至少需要 %@ 的可用磁盤空間才能啓動，當前只剩 %@。空間不足會導致插件啓動失敗或數據寫入失敗，請盡快清理磁盤。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumi 至少需要 %@ 的可用磁盤空間才能啓動，當前只剩 %@。空間不足會導致插件啓動失敗或數據寫入失敗，請盡快清理磁盤。"
          }
        }
      }
    },
    "Lumi needs at least %@ of free disk space to start. Only %@ remains. Free up disk space and restart — the data directory often contains large files you can clean up." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumi needs at least %@ of free disk space to start. Only %@ remains. Free up disk space and restart — the data directory often contains large files you can clean up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumi 至少需要 %@ 的可用磁盘空间才能启动，当前只剩 %@。释放磁盘空间后重新启动即可——数据目录里通常藏着可以清理的大文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumi 至少需要 %@ 的可用磁盤空間才能啓動，當前只剩 %@。釋放磁盤空間後重新啓動即可——數據目錄里通常藏著可以清理的大文件。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumi 至少需要 %@ 的可用磁盤空間才能啓動，當前只剩 %@。釋放磁盤空間後重新啓動即可——數據目錄里通常藏著可以清理的大文件。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumi 至少需要 %@ 的可用磁盤空間才能啓動，當前只剩 %@。釋放磁盤空間後重新啓動即可——數據目錄里通常藏著可以清理的大文件。"
