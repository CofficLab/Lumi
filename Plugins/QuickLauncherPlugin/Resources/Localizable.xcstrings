    "Type ? followed by your question in the launcher to send it to the current Lumi conversation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type ? followed by your question in the launcher to send it to the current Lumi conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在启动器中输入 ? 加问题，即可发送到当前 Lumi 会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在啟動器中輸入 ? 加問題，即可傳送到目前 Lumi 會話。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在啟動器中輸入 ? 加問題，即可傳送到目前 Lumi 會話。"
