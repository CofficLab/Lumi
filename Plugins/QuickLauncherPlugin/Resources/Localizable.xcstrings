    "Press the hotkey anywhere to open the launcher. Click Record, then press a key combination with ⌘/⌥/⌃.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the hotkey anywhere to open the launcher. Click Record, then press a key combination with ⌘/⌥/⌃."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意界面按热键即可打开启动器。点击「录制」后按下包含 ⌘/⌥/⌃ 的组合键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何畫面按快捷鍵即可開啟啟動器。點擊「錄製」後按下包含 ⌘/⌥/⌃ 的組合鍵。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何畫面按快捷鍵即可開啟啟動器。點擊「錄製」後按下包含 ⌘/⌥/⌃ 的組合鍵。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何畫面按快捷鍵即可開啟啟動器。點擊「錄製」後按下包含 ⌘/⌥/⌃ 的組合鍵。"
          }
        }
      }
    },
