    "Configure an AI provider in Settings before using the chat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure an AI provider in Settings before using the chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用对话前,需要先在「设置」中配置 AI 服务商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用對話前,需要先在「設定」中配置 AI 服務商。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用對話前,需要先在「設定」中配置 AI 服務商。"
          }
        },
        "zh-TW": {
          "stringUnit": {
