    "This manual covers the Chat panel, the core workspace of Lumi where you work with the AI.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This manual covers the Chat panel, the core workspace of Lumi where you work with the AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本手册介绍「对话」面板。对话是 Lumi 的核心工作区,通过与 AI 交流完成日常工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹「對話」面板。對話是 Lumi 的核心工作區,透過與 AI 交流完成日常工作。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹「對話」面板。對話是 Lumi 的核心工作區,透過與 AI 交流完成日常工作。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹「對話」面板。對話是 Lumi 的核心工作區,透過與 AI 交流完成日常工作。"
          }
        }
      }
    },
    "Basic Operations": {
      "localizations": {
        "en": {
