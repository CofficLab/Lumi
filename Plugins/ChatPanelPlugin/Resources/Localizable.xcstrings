    "Click the Chat icon in the activity bar to open the chat workspace.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the Chat icon in the activity bar to open the chat workspace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击活动栏中的「对话」图标,进入对话工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊活動欄中的「對話」圖示,進入對話工作區。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊活動欄中的「對話」圖示,進入對話工作區。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊活動欄中的「對話」圖示,進入對話工作區。"
          }
        }
      }
    },
    "Type your question in the input field and press Return to send it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type your question in the input field and press Return to send it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在输入框中输入问题,按回车发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入框中輸入問題,按 Return 傳送。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入框中輸入問題,按 Return 傳送。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入框中輸入問題,按 Return 傳送。"
          }
        }
      }
    },
    "The AI replies in the conversation; you can also ask it to perform tasks for you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI replies in the conversation; you can also ask it to perform tasks for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 会在对话中回复,也可以让它替你执行任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 會在對話中回覆,也可以讓它替你執行任務。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 會在對話中回覆,也可以讓它替你執行任務。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 會在對話中回覆,也可以讓它替你執行任務。"
          }
        }
      }
    },
