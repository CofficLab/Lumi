    "Get the currently selected project name and path. Returns empty status if no project is selected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get the currently selected project name and path. Returns empty status if no project is selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取当前选中的项目名称和路径。如果未选中项目，则返回空状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取得目前選取的專案名稱和路徑。若未選取專案，則回傳空狀態。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "取得目前選取的專案名稱和路徑。若未選取專案，則回傳空狀態。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "取得目前選取的專案名稱和路徑。若未選取專案，則回傳空狀態。"
          }
        }
      }
    },
