    "Add an existing local directory to the projects list without switching the current project.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an existing local directory to the projects list without switching the current project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将现有本地目录添加到项目列表，而不切换当前项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將現有本地目錄加入專案清單，而不切換目前專案。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將現有本地目錄加入專案清單，而不切換目前專案。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將現有本地目錄加入專案清單，而不切換目前專案。"
          }
        }
      }
    },
