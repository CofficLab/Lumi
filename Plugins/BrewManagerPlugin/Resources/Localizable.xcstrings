    "Browse all installed Homebrew formulae and casks. View package details including version, installation date, and dependencies.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse all installed Homebrew formulae and casks. View package details including version, installation date, and dependencies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览所有已安装的 Homebrew formula 和 cask。查看包详情，包括版本、安装日期和依赖关系。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览所有已安装的 Homebrew formula 和 cask。查看包详情，包括版本、安装日期和依赖关系。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览所有已安装的 Homebrew formula 和 cask。查看包详情，包括版本、安装日期和依赖关系。"
          }
        },
        "zh-TW": {
