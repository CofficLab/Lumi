    "Open the menu bar popup to choose a duration and start caffeinating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the menu bar popup to choose a duration and start caffeinating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开菜单栏弹窗选择时长并启动 caffeinate。"
