        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開選單列彈出視窗選擇時長並啟動 caffeinate。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
