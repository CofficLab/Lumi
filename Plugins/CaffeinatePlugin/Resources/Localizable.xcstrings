    "Your Mac will stay awake until deactivated or the timer expires.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac will stay awake until deactivated or the timer expires."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 将保持唤醒状态，直至手动停用或定时器到期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 將保持喚醒狀態，直至手動停用或計時器到期。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 將保持喚醒狀態，直至手動停用或計時器到期。"
