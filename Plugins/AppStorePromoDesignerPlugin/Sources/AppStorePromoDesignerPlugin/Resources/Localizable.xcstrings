    "Click Export and choose a folder; every image is saved as App Store-ready PNGs, grouped by language." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Export and choose a folder; every image is saved as App Store-ready PNGs, grouped by language."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击「导出」并选择文件夹；每张图片都会按 App Store 尺寸导出为 PNG，并按语言分好类。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按「匯出」並選擇資料夾；每張圖片都會按 App Store 尺寸匯出為 PNG，並按語言分好類。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按「匯出」並選擇資料夾；每張圖片都會按 App Store 尺寸匯出為 PNG，並按語言分好類。"
          }
        },
        "zh-TW" : {
