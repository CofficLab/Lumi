    "Describe your app and what to highlight, for example \"a promo image for a coffee tracker, highlight the brew timer\"." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe your app and what to highlight, for example \"a promo image for a coffee tracker, highlight the brew timer\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述你的应用和想突出的卖点，例如「为一个咖啡记录应用做宣传图，突出冲煮计时功能」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述你的應用程式和想突出的賣點，例如「為一個咖啡記錄應用程式製作宣傳圖，突出沖煮計時功能」。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述你的應用程式和想突出的賣點，例如「為一個咖啡記錄應用程式製作宣傳圖，突出沖煮計時功能」。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "描述你的 App 和想突出的賣點，例如「為一個咖啡記錄 App 製作宣傳圖，突出沖煮計時功能」。"
          }
        }
      }
    },
