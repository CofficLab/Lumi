    "This manual covers the interface and basic operations of the Resume Designer: asking the Agent to create resumes, previewing and editing them, and exporting or printing the result." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This manual covers the interface and basic operations of the Resume Designer: asking the Agent to create resumes, previewing and editing them, and exporting or printing the result."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本手册介绍简历设计器的界面与基本操作:让智能体创建简历、预览与修改,以及导出或打印成品。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本手冊介紹履歷設計器的介面與基本操作:讓智慧代理建立履歷、預覽與修改,以及匯出或列印成品。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本手冊介紹履歷設計器的介面與基本操作:讓智慧代理建立履歷、預覽與修改,以及匯出或列印成品。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本手冊介紹履歷設計器的介面與基本操作:讓智慧代理建立履歷、預覽與修改,以及匯出或列印成品。"
          }
        }
      }
    },
