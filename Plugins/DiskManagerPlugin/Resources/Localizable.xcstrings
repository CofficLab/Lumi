    "Cache cleanup only removes safe, regenerable files. System files and user documents are never affected." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache cleanup only removes safe, regenerable files. System files and user documents are never affected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓存清理仅移除安全、可重新生成的文件。系统文件与用户文档绝不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓存清理仅移除安全、可重新生成的文件。系统文件与用户文档绝不受影响。"
