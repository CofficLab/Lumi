        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一目了然地查看磁盘总量、已用与可用空间。监控存储健康并识别空间占用模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
