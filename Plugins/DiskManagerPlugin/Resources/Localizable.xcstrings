    "View total, used, and available disk space at a glance. Monitor storage health and identify space consumption patterns." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "View total, used, and available disk space at a glance. Monitor storage health and identify space consumption patterns."
