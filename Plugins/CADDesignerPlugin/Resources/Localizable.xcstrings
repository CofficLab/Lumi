    "Toolbar: provides New Project, Undo, Redo, Save, Load, and Export PNG." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toolbar: provides New Project, Undo, Redo, Save, Load, and Export PNG."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「工具栏」:提供「新建项目」「撤销」「重做」「保存」「加载」与「导出 PNG」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「工具列」:提供「新增專案」「還原」「重做」「儲存」「載入」與「匯出 PNG」。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「工具列」:提供「新增專案」「還原」「重做」「儲存」「載入」與「匯出 PNG」。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「工具列」:提供「新增專案」「復原」「重做」「儲存」「載入」與「匯出 PNG」。"
          }
        }
      }
    },
    "Component library: the left pane groups profiles by series and lists connectors; use the search field to filter, and click + to add a component." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Component library: the left pane groups profiles by series and lists connectors; use the search field to filter, and click + to add a component."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「组件库」:左侧面板按系列分组显示型材并列出连接件;可用搜索框筛选,点击「+」添加组件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「組件庫」:左側面板按系列分組顯示型材並列出連接件;可用搜尋欄篩選,點擊「+」新增組件。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「組件庫」:左側面板按系列分組顯示型材並列出連接件;可用搜尋欄篩選,點擊「+」新增組件。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「組件庫」:左側面板按系列分組顯示型材並列出連接件;可用搜尋欄篩選,點擊「+」新增組件。"
          }
        }
      }
    },
    "Viewport: the center area previews the design in 3D; when empty, it prompts you to add a profile." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viewport: the center area previews the design in 3D; when empty, it prompts you to add a profile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「视口」:中央区域以三维方式预览设计;为空时会提示先添加型材。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視埠」:中央區域以三維方式預覽設計;為空時會提示先新增型材。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視埠」:中央區域以三維方式預覽設計;為空時會提示先新增型材。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視埠」:中央區域以三維方式預覽設計;為空時會提示先新增型材。"
          }
        }
      }
    },
    "Inspector: the right pane edits the selected component's length, position, and rotation, and provides Delete and Measure." : {
      "localizations" : {
        "en" : {
