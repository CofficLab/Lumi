    "Define connections between components with rigid, hinge, or bolt joint types to build accurate assembly structures." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define connections between components with rigid, hinge, or bolt joint types to build accurate assembly structures."
          }
