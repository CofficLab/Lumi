        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 未綁定到任何編譯目標。跨文件語義導航可能不可用。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
