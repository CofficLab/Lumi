        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用多個圖層建構複雜圖示。可控制每個圖層的不透明度、陰影、模糊效果與變形屬性。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
