    "Click 「Grant Permission」 and enable the app in System Settings when prompted." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click 「Grant Permission」 and enable the app in System Settings when prompted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击「授予权限」，并在系统提示时于系统设置中启用本应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊「授予權限」，並在系統提示時於系統設定中啟用本應用程式。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊「授予權限」，並在系統提示時於系統設定中啟用本應用程式。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊「授予權限」，並在系統提示時於系統設定中啟用本應用程式。"
          }
        }
      }
    },
