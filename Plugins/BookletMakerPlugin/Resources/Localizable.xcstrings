    "Convert a PDF into a 2-up imposition ready for A4 duplex printing, folding and stapling.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert a PDF into a 2-up imposition ready for A4 duplex printing, folding and stapling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 PDF 拼成 2-up 版式，可用 A4 双面打印后对折装订成 A5 小册子。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把 PDF 拼成 2-up 版式，可用 A4 雙面打印後對摺裝訂成 A5 小冊子。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將 PDF 拼成 2-up 版面，可用 A4 雙面列印後對摺裝訂成 A5 小冊子。"
          }
        }
      }
    },
