    },
    "Sidebar: two modes via the switch at the top. Connections lists saved connections; Tables shows the object tree of the connected database with a filter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidebar: two modes via the switch at the top. Connections lists saved connections; Tables shows the object tree of the connected database with a filter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侧边栏:通过顶部切换在两种模式间切换。「连接」列出已保存的连接,「表」显示所连数据库的对象树并支持筛选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "側邊欄:透過頂部切換在兩種模式間切換。「連線」列出已保存的連線,「表」顯示所連資料庫的物件樹並支援篩選。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "側邊欄:透過頂部切換在兩種模式間切換。「連線」列出已保存的連線,「表」顯示所連資料庫的物件樹並支援篩選。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "側邊欄:透過頂部切換在兩種模式間切換。「連線」列出已保存的連線,「表」顯示所連資料庫的物件樹並支援篩選。"
          }
        }
      }
    },
    "Main area: the SQL editor with Run All and History buttons, the query results below, and an inspector for table structure." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Main area: the SQL editor with Run All and History buttons, the query results below, and an inspector for table structure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主区域:SQL 编辑器(带「全部运行」和「历史」按钮)、下方的查询结果,以及表结构检查器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主區域:SQL 編輯器(帶「全部執行」和「歷史」按鈕)、下方的查詢結果,以及資料表結構檢查器。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主區域:SQL 編輯器(帶「全部執行」和「歷史」按鈕)、下方的查詢結果,以及資料表結構檢查器。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主區域:SQL 編輯器(帶「全部執行」和「歷史」按鈕)、下方的查詢結果,以及資料表結構檢查器。"
          }
        }
      }
    },
