    "All activity data is stored locally on your device. No data is sent to external servers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All activity data is stored locally on your device. No data is sent to external servers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有活动数据均存储在本地设备上，不会发送至外部服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有活動數據均存儲在本地設備上，不會發送至外部伺服器。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有活動數據均儲存於本地設備上，不會發送至外部伺服器。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所有活動數據均儲存於本地設備上，不會發送至外部伺服器。"
          }
        }
      }
    },
