    "Get instant insights: total messages, active days, current/longest streaks, weekday distribution, and peak activity days." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get instant insights: total messages, active days, current/longest streaks, weekday distribution, and peak activity days."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取即时洞察：总消息数、活跃天数、当前/最长连续天数、工作日分布和峰值活跃日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獲取即時洞察：總訊息數、活躍天數、當前/最長連續天數、工作日分布和峰值活躍日。"
