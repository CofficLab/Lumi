        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獲取即時洞察：總訊息數、活躍天數、當前/最長連續天數、工作日分布和峰值活躍日。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
