    "Get instant insights: total messages, active days, current/longest streaks, weekday distribution, and peak activity days.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get instant insights: total messages, active days, current/longest streaks, weekday distribution, and peak activity days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取即时洞察：总消息数、活跃天数、当前/最长连续天数、工作日分布和峰值活跃日。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獲取即時洞察：總訊息數、活躍天數、當前/最長連續天數、工作日分布和峰值活躍日。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "獲取即時洞察：總訊息數、活躍天數、當前/最長連續天數、工作日分布和峰值活躍日。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "獲取即時洞察：總訊息數、活躍天數、當前/最長連續天數、工作日分布和峰值活躍日。"
          }
        }
      }
    },
    "Historical data is cached locally for instant loading. Today's activity is always fetched in real-time for accuracy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Historical data is cached locally for instant loading. Today's activity is always fetched in real-time for accuracy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史数据本地缓存实现即时加载，今日活跃度实时获取以确保准确性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史數據本地緩存實現即時載入，今日活躍度即時獲取以確保準確性。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史數據本地緩存實現即時載入，今日活躍度即時獲取以確保準確性。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史數據本地緩存實現即時載入，今日活躍度即時獲取以確保準確性。"
          }
        }
      }
    },
