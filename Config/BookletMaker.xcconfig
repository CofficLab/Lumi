//
// BookletMaker.xcconfig
// BookletMaker multiplatform target（Debug 与 Release 共用）。
// 版本号由 CI（set-booklet-version.sh）通过 tag 注入，此处为默认值。
//

#include "App-Shared.xcconfig"

// 同一 target 原生支持 macOS、iPhone 和 iPad。
SUPPORTED_PLATFORMS = macosx iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2
ENABLE_HARDENED_RUNTIME[sdk=iphoneos*] = NO
ENABLE_HARDENED_RUNTIME[sdk=iphonesimulator*] = NO
COMBINE_HIDPI_IMAGES[sdk=iphoneos*] = NO
COMBINE_HIDPI_IMAGES[sdk=iphonesimulator*] = NO

// 所有平台共用同一产品身份，用于 App Store universal purchase。
PRODUCT_BUNDLE_IDENTIFIER = com.coffic.bookletmaker
INFOPLIST_KEY_CFBundleDisplayName = BookletMaker
PRODUCT_NAME = BookletMaker

// 平台专用 Info.plist 配置。
INFOPLIST_FILE[sdk=macosx*] = BookletMakerApp/BookletMaker-Info.plist
INFOPLIST_FILE[sdk=iphoneos*] =
INFOPLIST_FILE[sdk=iphonesimulator*] =
INFOPLIST_KEY_LSApplicationCategoryType[sdk=macosx*] = public.app-category.utilities
INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*] = YES
INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*] = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations[sdk=iphoneos*] = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations[sdk=iphonesimulator*] = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad[sdk=iphoneos*] = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad[sdk=iphonesimulator*] = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// 图标
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// macOS 沙盒。iOS 自身始终运行在沙盒中。
ENABLE_APP_SANDBOX = YES
ENABLE_USER_SELECTED_FILES = readwrite

// 沙盒下显式关闭各项资源访问
ENABLE_INCOMING_NETWORK_CONNECTIONS = NO
ENABLE_OUTGOING_NETWORK_CONNECTIONS = NO
ENABLE_RESOURCE_ACCESS_AUDIO_INPUT = NO
ENABLE_RESOURCE_ACCESS_BLUETOOTH = NO
ENABLE_RESOURCE_ACCESS_CALENDARS = NO
ENABLE_RESOURCE_ACCESS_CAMERA = NO
ENABLE_RESOURCE_ACCESS_CONTACTS = NO
ENABLE_RESOURCE_ACCESS_LOCATION = NO
ENABLE_RESOURCE_ACCESS_PRINTING = NO
ENABLE_RESOURCE_ACCESS_USB = NO

// 权限
CODE_SIGN_ENTITLEMENTS = BookletMakerApp/App.entitlements

// 平台运行时路径。
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) @executable_path/Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) @executable_path/Frameworks

// 版本号（由 CI set-booklet-version.sh 按 booklet-v* tag 写入）
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
