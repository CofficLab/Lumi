{
  "sourceLanguage": "en",
  "strings": {
    "Behavior": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Behavior"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "行为"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "行為"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "行為"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "行為"}}}},
    "Browse projects and edit source files in a VS Code-style workspace.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Browse projects and edit source files in a VS Code-style workspace."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在类似 VS Code 的工作区中浏览项目并编辑源文件。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在類似 VS Code 的工作區中瀏覽專案並編輯原始檔案。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "在類似 VS Code 的工作區中瀏覽專案並編輯原始檔案。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "在類似 VS Code 的工作區中瀏覽專案並編輯原始檔案。"}}}},
    "Code Editor": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Code Editor"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "代码编辑器"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "程式碼編輯器"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "程式碼編輯器"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "程式碼編輯器"}}}},
    "Code Editor displays the file currently selected in the project Explorer. The Explorer remains responsible for browsing files; this plugin provides the main editing surface.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Code Editor displays the file currently selected in the project Explorer. The Explorer remains responsible for browsing files; this plugin provides the main editing surface."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "代码编辑器显示项目资源管理器中当前选中的文件。资源管理器负责浏览文件；本插件提供主要的编辑界面。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "程式碼編輯器顯示專案資源管理器中目前選取的檔案。資源管理器負責瀏覽檔案；本插件提供主要的編輯介面。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "程式碼編輯器顯示專案資源管理器中目前選取的檔案。資源管理器負責瀏覽檔案；本插件提供主要的編輯介面。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "程式碼編輯器顯示專案資源管理器中目前選取的檔案。資源管理器負責瀏覽檔案；本插件提供主要的編輯介面。"}}}},
    "Core Capabilities": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Core Capabilities"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "核心能力"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "核心功能"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "核心功能"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "核心功能"}}}},
    "Current File": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Current File"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前文件"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "目前檔案"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "目前檔案"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "目前檔案"}}}},
    "Display and edit the file currently selected in the project Explorer.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Display and edit the file currently selected in the project Explorer."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "显示并编辑项目资源管理器中当前选中的文件。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "顯示並編輯專案資源管理器中目前選取的檔案。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "顯示並編輯專案資源管理器中目前選取的檔案。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "顯示並編輯專案資源管理器中目前選取的檔案。"}}}},
    "Edit and Save": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Edit and Save"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "编辑和保存"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "編輯與儲存"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "編輯與儲存"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "編輯與儲存"}}}},
    "Edit the file directly in the main editor area.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Edit the file directly in the main editor area."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "直接在主编辑区域中编辑文件。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "直接在主要編輯區域中編輯檔案。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "直接在主要編輯區域中編輯檔案。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "直接在主要編輯區域中編輯檔案。"}}}},
    "Edit text directly in the editor and save changes with Cmd+S.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Edit text directly in the editor and save changes with Cmd+S."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "直接在编辑器中修改文本，并使用 Cmd+S 保存更改。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "直接在編輯器中修改文字，並使用 Cmd+S 儲存變更。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "直接在編輯器中修改文字，並使用 Cmd+S 儲存變更。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "直接在編輯器中修改文字，並使用 Cmd+S 儲存變更。"}}}},
    "Editing": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Editing"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "编辑"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "編輯"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "編輯"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "編輯"}}}},
    "Enable Code Editor from the plugin settings if it is disabled.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Enable Code Editor from the plugin settings if it is disabled."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "如果代码编辑器已禁用，请先在插件设置中启用它。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "如果程式碼編輯器已停用，請先在插件設定中啟用它。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "如果程式碼編輯器已停用，請先在插件設定中啟用它。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "如果程式碼編輯器已停用，請先在插件設定中啟用它。"}}}},
    "Experience": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Experience"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "使用体验"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用體驗"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "使用體驗"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "使用體驗"}}}},
    "If the selected item is not a text file, the editor shows a non-editable state.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "If the selected item is not a text file, the editor shows a non-editable state."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "如果选中的项目不是文本文件，编辑器会显示不可编辑状态。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "如果選取的項目不是文字檔案，編輯器會顯示不可編輯狀態。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "如果選取的項目不是文字檔案，編輯器會顯示不可編輯狀態。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "如果選取的項目不是文字檔案，編輯器會顯示不可編輯狀態。"}}}},
    "Line range": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Line range"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "行号范围"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "行號範圍"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "行號範圍"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "行號範圍"}}}},
    "Open a File": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open a File"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开文件"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "開啟檔案"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "開啟檔案"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "開啟檔案"}}}},
    "Open the Explorer rail and select a source file.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open the Explorer rail and select a source file."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "打开资源管理器侧栏并选择源文件。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "開啟資源管理器側欄並選取原始檔案。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "開啟資源管理器側欄並選取原始檔案。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "開啟資源管理器側欄並選取原始檔案。"}}}},
    "Overview": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Overview"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "概览"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "概覽"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "概覽"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "概覽"}}}},
    "Press Cmd+S to save the current file.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Press Cmd+S to save the current file."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "按下 Cmd+S 保存当前文件。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "按下 Cmd+S 儲存目前檔案。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "按下 Cmd+S 儲存目前檔案。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "按下 Cmd+S 儲存目前檔案。"}}}},
    "Save": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Save"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "保存"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "儲存"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "儲存"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "儲存"}}}},
    "Select Code Editor in the Activity Bar.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Select Code Editor in the Activity Bar."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "在活动栏中选择代码编辑器。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "在活動列中選取程式碼編輯器。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "在活動列中選取程式碼編輯器。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "在活動列中選取程式碼編輯器。"}}}},
    "Selected code": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Selected code"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "选中的代码"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "選取的程式碼"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "選取的程式碼"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "選取的程式碼"}}}},
    "Send to Conversation": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Send to Conversation"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "发送到对话"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "傳送至對話"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "傳送至對話"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "傳送至對話"}}}},
    "Syntax Highlighting": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Syntax Highlighting"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "语法高亮"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "語法高亮"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "語法高亮"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "語法高亮"}}}},
    "Syntax highlighting is provided by the shared Editor Host.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Syntax highlighting is provided by the shared Editor Host."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "语法高亮由共享编辑器宿主提供。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "語法高亮由共用編輯器主機提供。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "語法高亮由共用編輯器主機提供。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "語法高亮由共用編輯器主機提供。"}}}},
    "The current file comes from ProjectProviding. When another plugin changes the current file, Code Editor receives the change and refreshes its content automatically.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The current file comes from ProjectProviding. When another plugin changes the current file, Code Editor receives the change and refreshes its content automatically."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "当前文件来自 ProjectProviding。当其他插件更改当前文件时，代码编辑器会接收更改并自动刷新内容。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "目前檔案來自 ProjectProviding。當其他插件變更目前檔案時，程式碼編輯器會接收變更並自動重新整理內容。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "目前檔案來自 ProjectProviding。當其他插件變更目前檔案時，程式碼編輯器會接收變更並自動重新整理內容。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "目前檔案來自 ProjectProviding。當其他插件變更目前檔案時，程式碼編輯器會接收變更並自動重新整理內容。"}}}},
    "The editor automatically loads and displays the selected file.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The editor automatically loads and displays the selected file."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "编辑器会自动加载并显示选中的文件。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "編輯器會自動載入並顯示選取的檔案。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "編輯器會自動載入並顯示選取的檔案。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "編輯器會自動載入並顯示選取的檔案。"}}}},
    "The editor follows the file selected in the project Explorer.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The editor follows the file selected in the project Explorer."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "编辑器会跟随项目资源管理器中选中的文件。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "編輯器會跟隨專案資源管理器中選取的檔案。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "編輯器會跟隨專案資源管理器中選取的檔案。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "編輯器會跟隨專案資源管理器中選取的檔案。"}}}},
    "The shared editor surface detects the file language and highlights source code.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "The shared editor surface detects the file language and highlights source code."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "共享编辑器表面会识别文件语言并为源代码添加高亮。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "共用編輯器表面會識別檔案語言並為原始碼加上高亮。"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "共用編輯器表面會識別檔案語言並為原始碼加上高亮。"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "共用編輯器表面會識別檔案語言並為原始碼加上高亮。"}}}},
    "User Manual": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "User Manual"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "用户手册"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "使用手冊"}}, "zh-HK": {"stringUnit": {"state": "translated", "value": "使用手冊"}}, "zh-TW": {"stringUnit": {"state": "translated", "value": "使用手冊"}}}}
  },
  "version": "1.0"
}
