    "Connect Lumi to external editors": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Lumi to external editors"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Lumi 接入外部编辑器"
          }
        },
        "zh-Hant": {
