{
  "sourceLanguage": "en",
  "strings": {
    "%lld": {},
    "A JSON-RPC response with protocolVersion 1 and agentInfo.name \"lumi-acp\" means the handshake succeeded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A JSON-RPC response with protocolVersion 1 and agentInfo.name \"lumi-acp\" means the handshake succeeded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若返回 protocolVersion 为 1 且 agentInfo.name 为 \"lumi-acp\" 的 JSON-RPC 响应，即表示握手成功。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若回傳 protocolVersion 為 1 且 agentInfo.name 為 \"lumi-acp\" 的 JSON-RPC 回應，即表示握手成功。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "若回傳 protocolVersion 為 1 且 agentInfo.name 為 \"lumi-acp\" 的 JSON-RPC 回應，即表示握手成功。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "若回傳 protocolVersion 為 1 且 agentInfo.name 為 \"lumi-acp\" 的 JSON-RPC 回應，即表示握手成功。"
          }
        }
      }
    },
    "A model and API key configured in Lumi — the headless process reuses the app's Keychain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model and API key configured in Lumi — the headless process reuses the app's Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Lumi 中配置模型与 API 密钥（headless 进程会复用应用的钥匙串）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Lumi 中設定模型與 API 金鑰（headless 程序會複用應用程式的鑰匙圈）。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Lumi 中設定模型與 API 金鑰（headless 程序會複用應用程式的鑰匙圈）。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 Lumi 中設定模型與 API 金鑰（headless 程序會複用應用程式的鑰匙圈）。"
          }
        }
      }
    },
    "ACP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ACP"
