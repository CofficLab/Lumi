        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在 Lumi 中設定模型與 API 金鑰（headless 程序會複用應用程式的鑰匙圈）。"
          }
        },
        "zh-HK" : {
