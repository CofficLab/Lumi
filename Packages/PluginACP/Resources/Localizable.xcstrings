    "ACP lets supported editors (VS Code, Zed, and more) run Lumi as their built-in coding agent over stdio, reusing Lumi's model routing, tool system, and project intelligence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ACP lets supported editors (VS Code, Zed, and more) run Lumi as their built-in coding agent over stdio, reusing Lumi's model routing, tool system, and project intelligence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Client Protocol（ACP）让支持该协议的编辑器（VS Code、Zed 等）通过 stdio 把 Lumi 作为内置编码 agent 使用，并复用 Lumi 的模型路由、工具系统与项目智能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Client Protocol（ACP）讓支援該協議的編輯器（VS Code、Zed 等）透過 stdio 把 Lumi 作為內建編碼 agent 使用，並複用 Lumi 的模型路由、工具系統與專案智能。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Client Protocol（ACP）讓支援該協議的編輯器（VS Code、Zed 等）透過 stdio 把 Lumi 作為內建編碼 agent 使用，並複用 Lumi 的模型路由、工具系統與專案智能。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Client Protocol（ACP）讓支援該協議的編輯器（VS Code、Zed 等）透過 stdio 把 Lumi 作為內建編碼 agent 使用，並複用 Lumi 的模型路由、工具系統與專案智能。"
          }
        }
      }
    },
