    },
    "A JSON-RPC response with protocolVersion 1 and agentInfo.name \"lumi-acp\" means the handshake succeeded." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A JSON-RPC response with protocolVersion 1 and agentInfo.name \"lumi-acp\" means the handshake succeeded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若返回 protocolVersion 为 1 且 agentInfo.name 为 \"lumi-acp\" 的 JSON-RPC 响应，即表示握手成功。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若回傳 protocolVersion 為 1 且 agentInfo.name 為 \"lumi-acp\" 的 JSON-RPC 回應，即表示握手成功。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若回傳 protocolVersion 為 1 且 agentInfo.name 為 \"lumi-acp\" 的 JSON-RPC 回應，即表示握手成功。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若回傳 protocolVersion 為 1 且 agentInfo.name 為 \"lumi-acp\" 的 JSON-RPC 回應，即表示握手成功。"
          }
        }
      }
    },
    "A model and API key configured in Lumi — the headless process reuses the app's Keychain." : {
