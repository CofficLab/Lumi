    "The Lumi app never auto-starts the ACP server — stdin belongs to the editor. Only the headless entry point serves the protocol.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lumi app never auto-starts the ACP server — stdin belongs to the editor. Only the headless entry point serves the protocol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumi 应用不会自动启动 ACP 服务器——stdin 属于编辑器，只有 headless 入口会提供该协议服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumi 應用程式不會自動啟動 ACP 伺服器——stdin 屬於編輯器，只有 headless 入口會提供該協定服務。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumi 應用程式不會自動啟動 ACP 伺服器——stdin 屬於編輯器，只有 headless 入口會提供該協定服務。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumi 應用程式不會自動啟動 ACP 伺服器——stdin 屬於編輯器，只有 headless 入口會提供該協定服務。"
          }
        }
      }
    },
    "Tool approvals appear as permission prompts inside the editor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool approvals appear as permission prompts inside the editor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具授权会以权限提示的形式显示在编辑器中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具授權會以權限提示的形式顯示在編輯器中。"
          }
        },
        "zh-HK": {
          "stringUnit": {
