    "Create a new ACP session in the editor and send a prompt. Lumi runs the turn and streams updates back to the editor." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a new ACP session in the editor and send a prompt. Lumi runs the turn and streams updates back to the editor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在编辑器中创建新的 ACP 会话并发送提示。Lumi 会执行回合并将更新流式回编辑器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在編輯器中建立新的 ACP 會話並發送提示。Lumi 會執行回合並將更新串流回編輯器。"
          }
        },
        "zh-HK" : {
