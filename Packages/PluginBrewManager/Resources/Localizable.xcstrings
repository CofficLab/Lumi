        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹套件管理的介面與基本操作:查看已安裝的套件、更新套件以及搜尋並安裝套件。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
