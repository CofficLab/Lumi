    "This manual covers the interface and basic operations of the Package Management tool: viewing installed packages, updating packages, and searching for and installing packages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This manual covers the interface and basic operations of the Package Management tool: viewing installed packages, updating packages, and searching for and installing packages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本手册介绍包管理的界面与基本操作:查看已安装的软件包、更新软件包以及搜索并安装软件包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹套件管理的介面與基本操作:查看已安裝的套件、更新套件以及搜尋並安裝套件。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹套件管理的介面與基本操作:查看已安裝的套件、更新套件以及搜尋並安裝套件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹套件管理的介面與基本操作:查看已安裝的套件、更新套件以及搜尋並安裝套件。"
          }
        }
      }
    },
