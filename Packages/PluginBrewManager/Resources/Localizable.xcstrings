    "Installed tab: lists installed packages with their versions; casks are tagged, and each row provides Uninstall.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed tab: lists installed packages with their versions; casks are tagged, and each row provides Uninstall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「已安装」标签页:列出已安装的软件包及其版本;cask 类软件包带有标记,每行提供「卸载」按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「已安裝」標籤頁:列出已安裝的套件及其版本;cask 類套件帶有標記,每列提供「解除安裝」按鈕。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「已安裝」標籤頁:列出已安裝的套件及其版本;cask 類套件帶有標記,每列提供「解除安裝」按鈕。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「已安裝」分頁:列出已安裝的套件及其版本;cask 類套件帶有標記,每列提供「解除安裝」按鈕。"
          }
        }
      }
    },
