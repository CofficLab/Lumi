    "Open the Installed tab to view installed packages and their versions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Installed tab to view installed packages and their versions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「已安装」标签页,查看已安装的软件包及其版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「已安裝」標籤頁,查看已安裝的套件及其版本。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「已安裝」標籤頁,查看已安裝的套件及其版本。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「已安裝」分頁,查看已安裝的套件及其版本。"
          }
        }
      }
    },
    "Open the Search tab, type a name, and click Install on a result.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Search tab, type a name, and click Install on a result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「搜索」标签页,输入名称,并在某条结果上点击「安装」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「搜尋」標籤頁,輸入名稱,並在某條結果上點擊「安裝」。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「搜尋」標籤頁,輸入名稱,並在某條結果上點擊「安裝」。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「搜尋」分頁,輸入名稱,並在某條結果上點擊「安裝」。"
          }
        }
      }
    },
    "Open the Updates tab and click Update All, or update a single package with Update.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Updates tab and click Update All, or update a single package with Update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「更新」标签页,点击「更新全部」,或使用单行的「更新」按钮更新单个软件包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「更新」標籤頁,點擊「更新全部」,或使用單列的「更新」按鈕更新單一套件。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「更新」標籤頁,點擊「更新全部」,或使用單列的「更新」按鈕更新單一套件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「更新」分頁,點擊「更新全部」,或使用單列的「更新」按鈕更新單一套件。"
          }
        }
      }
    },
