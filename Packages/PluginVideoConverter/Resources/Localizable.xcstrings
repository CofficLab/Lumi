    "Drop zone: drag a video file onto it, or click to browse; the selected file shows its name, size, and a Clear button.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop zone: drag a video file onto it, or click to browse; the selected file shows its name, size, and a Clear button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放区:将视频文件拖入其中,或点击浏览文件;选中文件后会显示文件名、大小以及「清除」按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放區:將影片檔案拖入其中,或點擊瀏覽檔案;選取檔案後會顯示檔名、大小以及「清除」按鈕。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放區:將影片檔案拖入其中,或點擊瀏覽檔案;選取檔案後會顯示檔名、大小以及「清除」按鈕。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放區:將影片檔案拖入其中,或點擊瀏覽檔案;選取檔案後會顯示檔名、大小以及「清除」按鈕。"
          }
        }
      }
    },
