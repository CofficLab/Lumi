    "Click Convert and wait for the progress to finish, or click Cancel to abort.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Convert and wait for the progress to finish, or click Cancel to abort."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「转换」并等待进度完成,也可点击「取消」中止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊「轉換」並等待進度完成,也可點擊「取消」中止。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊「轉換」並等待進度完成,也可點擊「取消」中止。"
          }
