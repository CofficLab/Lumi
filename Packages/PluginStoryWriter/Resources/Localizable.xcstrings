          }
        }
      }
    },
    "Sidebar: the Story Outline rail with the story picker, the + button for a new story, the import button for Markdown files, and the chapter tree.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar: the Story Outline rail with the story picker, the + button for a new story, the import button for Markdown files, and the chapter tree."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏:即「故事大纲」栏,包含故事选择器、新建故事的「+」按钮、导入 Markdown 文件的按钮以及章节树。"
          }
        },
