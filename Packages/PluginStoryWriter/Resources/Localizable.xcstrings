    "This manual covers the interface and basic operations of Story Writer: creating and importing stories, writing chapters, and exporting them as Markdown.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This manual covers the interface and basic operations of Story Writer: creating and importing stories, writing chapters, and exporting them as Markdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本手册介绍「故事创作」的界面与基本操作:新建或导入故事、撰写章节并导出为 Markdown。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹「故事創作」的介面與基本操作:新增或匯入故事、撰寫章節並匯出為 Markdown。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹「故事創作」的介面與基本操作:新增或匯入故事、撰寫章節並匯出為 Markdown。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹「故事創作」的介面與基本操作:新增或匯入故事、撰寫章節並匯出為 Markdown。"
          }
        }
      }
    },
    "Interface": {
      "localizations": {
        "en": {
