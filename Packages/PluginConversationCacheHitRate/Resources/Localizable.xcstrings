    "Waiting for the first assistant response with cache usage data." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for the first assistant response with cache usage data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待第一条包含缓存用量数据的助手回复。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待第一條包含快取用量資料的助手回覆。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待第一筆包含快取用量資料的助手回覆。"
          }
        }
      }
    },
    "命中率 = 缓存读取 tokens ÷ 总输入 tokens。该数值按 token 加权，缓存命中越高，重复上下文计费越低、响应越快。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hit rate = cached tokens ÷ total input tokens. This value is token-weighted: higher cache hits mean lower repeated context costs and faster responses."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命中率 = 缓存读取 tokens ÷ 总输入 tokens。该数值按 token 加权，缓存命中越高，重复上下文计费越低、响应越快。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命中率 = 快取讀取 tokens ÷ 總輸入 tokens。該數值按 token 加權，快取命中越高，重複上下文計費越低、回應越快。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命中率 = 快取讀取 tokens ÷ 總輸入 tokens。該數值按 token 加權，快取命中越高，重複上下文計費越低、回應越快。"
          }
        }
      }
    }
