    "Choose a duration to start preventing sleep, or tap one of the three quick actions to set how the screen behaves." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a duration to start preventing sleep, or tap one of the three quick actions to set how the screen behaves."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个时长开始防止休眠,或点击三个快捷操作之一设定屏幕行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一個時長開始防止休眠,或點擊三個快捷操作之一設定螢幕行為。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一個時長開始防止休眠,或點擊三個快捷操作之一設定螢幕行為。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇一個時長開始防止休眠,或點擊三個快捷操作之一設定螢幕行為。"
          }
        }
      }
    },
