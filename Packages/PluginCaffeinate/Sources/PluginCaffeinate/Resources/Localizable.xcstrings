    "Keeping the screen on increases power consumption; prefer Allow screen off or Turn off screen when the display is not needed." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeping the screen on increases power consumption; prefer Allow screen off or Turn off screen when the display is not needed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕保持常亮会增加耗电,不需要看屏幕时可选择「允许关闭屏幕」或「关闭屏幕」模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕保持常亮會增加耗電,不需要看螢幕時可選擇「允許關閉螢幕」或「關閉螢幕」模式。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
