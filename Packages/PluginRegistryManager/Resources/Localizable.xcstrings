    "Card grid: one card per registry type, such as NPM, Yarn, PNPM, Docker, Pip, and Go Proxy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card grid: one card per registry type, such as NPM, Yarn, PNPM, Docker, Pip, and Go Proxy."
