    "Open the Registry Manager tab; the current registry of each type is read automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Registry Manager tab; the current registry of each type is read automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开注册表管理器标签页,各类型的当前注册表会自动读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟註冊表管理器標籤頁,各類型的目前註冊表會自動讀取。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
