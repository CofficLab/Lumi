    },
    "Click the Current Registry address to copy it; a toast confirms the copy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the Current Registry address to copy it; a toast confirms the copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「当前注册表」地址即可复制,弹出提示确认已复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊「目前註冊表」位址即可複製,彈出提示確認已複製。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
