    "Click the refresh button on a card to re-read that registry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the refresh button on a card to re-read that registry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击卡片上的刷新按钮,重新读取该注册表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
