    "Disk cache is disposable acceleration data. Clearing it will not delete any of your projects or documents; content will be re-fetched or rebuilt when needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk cache is disposable acceleration data. Clearing it will not delete any of your projects or documents; content will be re-fetched or rebuilt when needed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘缓存是可删除的加速数据。清空不会删除任何项目或文档；需要的内容会重新下载或重建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟快取是可刪除的加速資料。清空不會刪除任何專案或文件；需要的內容會重新下載或重建。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟快取是可刪除的加速資料。清空不會刪除任何專案或文件；需要的內容會重新下載或重建。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟快取是可刪除的加速資料。清空不會刪除任何專案或文件；需要的內容會重新下載或重建。"
          }
        }
      }
    },
