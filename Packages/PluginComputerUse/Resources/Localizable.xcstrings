    "Accessibility permission is required. Open Lumi Settings > Computer Use.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is required. Open Lumi Settings > Computer Use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限。请打开 Lumi 设置 > Computer Use。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要輔助功能權限。請開啟 Lumi 設定 > Computer Use。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "需要輔助功能權限。請開啟 Lumi 設定 > Computer Use。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "需要輔助功能權限。請開啟 Lumi 設定 > Computer Use。"
          }
        }
      }
    },
    "Allowed Applications": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed Applications"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
