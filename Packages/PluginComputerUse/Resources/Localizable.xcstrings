        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图捕获后目标窗口已发生变化。请再次调用 computer_observe。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖擷取後目標視窗已變更。請再次呼叫 computer_observe。"
