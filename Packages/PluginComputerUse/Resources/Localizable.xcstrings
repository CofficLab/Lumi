    "This step uses your mouse and keyboard. Permission is remembered for this app. You can stop at any time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This step uses your mouse and keyboard. Permission is remembered for this app. You can stop at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此步骤需要使用当前电脑的鼠标和键盘。允许后会记住此应用；你可以随时停止。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此步驟需要使用目前電腦的滑鼠和鍵盤。允許後會記住此應用程式；你可以隨時停止。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此步驟需要使用目前電腦的滑鼠和鍵盤。允許後會記住此應用程式；你可以隨時停止。"
          }
        }
      }
    },
    "{progress} · Please pause mouse and keyboard use. Your input pauses Lumi. Press ⌘⇧Esc to stop.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{progress} · Please pause mouse and keyboard use. Your input pauses Lumi. Press ⌘⇧Esc to stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{progress} · 请暂时不要使用鼠标和键盘。你开始操作时，Lumi 会暂停。按 ⌘⇧Esc 停止。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "{progress} · 請暫時不要使用滑鼠和鍵盤。你開始操作時，Lumi 會暫停。按 ⌘⇧Esc 停止。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "{progress} · 請暫時不要使用滑鼠和鍵盤。你開始操作時，Lumi 會暫停。按 ⌘⇧Esc 停止。"
          }
        }
      }
    },
    "You can use your computer. Continuing checks the screen again without replaying earlier clicks.": {
      "localizations": {
