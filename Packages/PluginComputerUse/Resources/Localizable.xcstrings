    "Allows Lumi to capture the selected application window.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows Lumi to capture the selected application window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Lumi 捕获所选应用的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Lumi 擷取所選應用程式的視窗。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Lumi 擷取所選應用程式的視窗。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Lumi 擷取所選應用程式的視窗。"
          }
        }
      }
    },
    "Allows Lumi to click, type, scroll, and navigate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows Lumi to click, type, scroll, and navigate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Lumi 点击、输入、滚动与导航。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Lumi 點擊、輸入、捲動與導覽。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Lumi 點擊、輸入、捲動與導覽。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Lumi 點擊、輸入、捲動與導覽。"
          }
        }
      }
    },
    "Computer Use": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use"
          }
        }
      }
    },
    "Computer Use captures only the selected window. Password fields are blocked, stale screenshot coordinates are rejected, and state-changing batches require approval in Build mode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use captures only the selected window. Password fields are blocked, stale screenshot coordinates are rejected, and state-changing batches require approval in Build mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 仅捕获所选窗口。密码输入框会被屏蔽，过时的截图坐标会被拒绝，而改变状态的批量操作需在 Build 模式下获得批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 僅擷取所選視窗。密碼輸入欄會被封鎖，過時的截圖座標會被拒絕，而改變狀態的批次操作需在 Build 模式下獲得批准。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 僅擷取所選視窗。密碼輸入欄會被封鎖，過時的截圖座標會被拒絕，而改變狀態的批次操作需在 Build 模式下獲得批准。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 僅擷取所選視窗。密碼輸入欄會被封鎖，過時的截圖座標會被拒絕，而改變狀態的批次操作需在 Build 模式下獲得批准。"
          }
        }
      }
    },
    "Computer Use requires a model that supports both vision and tools. Select a compatible model and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use requires a model that supports both vision and tools. Select a compatible model and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 需要使用同时支持视觉与工具的模型。请选择兼容的模型后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 需要使用同時支援視覺與工具的模型。請選擇相容的模型後重試。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 需要使用同時支援視覺與工具的模型。請選擇相容的模型後重試。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer Use 需要使用同時支援視覺與工具的模型。請選擇相容的模型後重試。"
          }
        }
      }
    },
    "Control of {app} is not allowed. Add it under Lumi Settings > Computer Use.": {
      "localizations": {
        "en": {
          "stringUnit": {
