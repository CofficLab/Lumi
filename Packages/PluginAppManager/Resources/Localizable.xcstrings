    "Click Refresh to rescan when the list looks out of date.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Refresh to rescan when the list looks out of date."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当列表内容过期时,点击「刷新」重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當清單內容過期時,點擊「重新整理」重新掃描。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當清單內容過期時,點擊「重新整理」重新掃描。"
