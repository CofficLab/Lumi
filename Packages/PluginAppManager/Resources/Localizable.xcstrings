    "Apps list: the left pane lists installed applications, with a search field and a Refresh button on top.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps list: the left pane lists installed applications, with a search field and a Refresh button on top."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「应用列表」:左侧面板列出已安装的应用,顶部提供搜索框与「刷新」按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「應用列表」:左側面板列出已安裝的應用,頂部提供搜尋欄與「重新整理」按鈕。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「應用列表」:左側面板列出已安裝的應用,頂部提供搜尋欄與「重新整理」按鈕。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「應用列表」:左側面板列出已安裝的應用,頂部提供搜尋欄與「重新整理」按鈕。"
          }
        }
      }
    },
