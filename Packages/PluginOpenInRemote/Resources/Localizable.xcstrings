    "The project must be a Git repository with an origin remote that points to a web host.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project must be a Git repository with an origin remote that points to a web host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目必须是 Git 仓库，且 origin 远程地址指向网页托管服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案必須是 Git 儲存庫，且 origin 遠端網址指向網頁託管服務。"
          }
        },
