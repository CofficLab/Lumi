        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 origin 远程地址，并把 SSH 与 HTTPS 地址转换为网页链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取 origin 遠端網址，並把 SSH 與 HTTPS 網址轉換為網頁連結。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取 origin 遠端網址，並把 SSH 與 HTTPS 網址轉換為網頁連結。"
          }
        },
        "zh-TW": {
