      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean up system caches to free up disk space. Safely remove temporary files without affecting system stability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理系统缓存以释放磁盘空间。安全移除临时文件，不影响系统稳定性。"
