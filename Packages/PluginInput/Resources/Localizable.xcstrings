    "Add-rule card: under 「Add New Rule」, pick an application and an input source, then click 「Add」.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add-rule card: under 「Add New Rule」, pick an application and an input source, then click 「Add」."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建规则卡片：在「新建规则」下选择应用与输入源，然后点击「添加」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新建規則卡片：在「新建規則」下選擇應用與輸入源，然後點擊「新增」。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "新建規則卡片：在「新建規則」下選擇應用與輸入源，然後點擊「新增」。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "新建規則卡片：在「新建規則」下選擇應用與輸入源，然後點擊「新增」。"
          }
        }
      }
    },
