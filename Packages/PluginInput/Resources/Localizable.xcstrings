    "Switch card: the 「Enable Auto Input Source Switching」 toggle turns the feature on or off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch card: the 「Enable Auto Input Source Switching」 toggle turns the feature on or off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开关卡片：「启用自动输入源切换」开关用于开启或关闭此功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開關卡片：「啟用自動輸入源切換」開關用於開啟或關閉此功能。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開關卡片：「啟用自動輸入源切換」開關用於開啟或關閉此功能。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
