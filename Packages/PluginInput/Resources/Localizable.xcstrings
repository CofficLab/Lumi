          }
        }
      }
    },
    "To remove a rule, right-click it and choose 「Delete」.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To remove a rule, right-click it and choose 「Delete」."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需移除规则，请右键点击该规则并选择「删除」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如需移除規則，請右鍵點擊該規則並選擇「刪除」。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如需移除規則，請右鍵點擊該規則並選擇「刪除」。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
