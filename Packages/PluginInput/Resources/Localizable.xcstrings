    "Under 「Add New Rule」, choose an application from 「Select Application」; running applications are listed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under 「Add New Rule」, choose an application from 「Select Application」; running applications are listed."
