    },
    "The input source switches when the matched application comes to the foreground.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The input source switches when the matched application comes to the foreground."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当匹配的应用位于前台时，输入源才会切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當匹配的應用位於前台時，輸入源才會切換。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "當匹配的應用位於前台時，輸入源才會切換。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "當匹配的應用位於前台時，輸入源才會切換。"
          }
        }
      }
    },
    "This manual covers the interface and basic operations of the Input Manager: switching the input source automatically for each application.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This manual covers the interface and basic operations of the Input Manager: switching the input source automatically for each application."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本手册介绍「输入管理器」的界面与基本操作：按应用自动切换输入源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹「輸入管理器」的介面與基本操作：按應用自動切換輸入源。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹「輸入管理器」的介面與基本操作：按應用自動切換輸入源。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
