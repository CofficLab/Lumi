    "Authentication uses your existing ~/.ssh keys and ssh-agent. No passwords are stored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication uses your existing ~/.ssh keys and ssh-agent. No passwords are stored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证使用现有的 ~/.ssh 密钥与 ssh-agent，不保存任何密码。"
          }
        }
      }
    },
    "about.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server Manager lets you look after remote machines without leaving Lumi: connection profiles, metrics overview, process and Docker container management, a remote console, and Agent tools. It drives the system ssh binary, so your existing ~/.ssh/config, keys and ssh-agent keep working. Write operations always ask for confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器管理让你不用离开 Lumi 就能照看远程机器：连接配置、指标概览、进程与 Docker 容器管理、远程控制台，以及 Agent 工具。插件驱动系统 ssh 二进制，因此现有的 ~/.ssh/config、密钥与 ssh-agent 都能继续使用。写操作始终需要确认。"
          }
        }
      }
    },
    "manual.connections": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connections: add a server with host, port and user. The host can be an IP, a domain, or an alias from ~/.ssh/config. Authentication uses your existing keys and ssh-agent; the plugin never stores passwords. The first connection records the host fingerprint (trust on first use); a changed fingerprint is rejected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接：添加服务器时填写主机、端口与用户。主机可以是 IP、域名或 ~/.ssh/config 中的别名。认证使用现有密钥与 ssh-agent，插件不保存任何密码。首次连接会记录主机指纹（首次信任），指纹变化时拒绝连接。"
          }
        }
      }
    },
    "manual.probe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overview: collects OS, hostname, uptime, load, CPU, memory and disk usage over SSH with fixed read-only scripts. Processes lists the top CPU consumers and can terminate a process (SIGTERM/SIGKILL, with confirmation). Containers lists Docker containers and can start/stop/restart them (with confirmation). Console runs a command on the server; commands that may modify the server require confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "概览：通过 SSH 执行固定只读脚本，采集系统、主机名、运行时长、负载、CPU、内存与磁盘用量。进程页列出 CPU 占用最高的进程，可结束进程（SIGTERM/SIGKILL，需确认）。容器页列出 Docker 容器，可启动/停止/重启（需确认）。控制台在服务器上执行命令；可能修改服务器的命令需确认。"
          }
        }
      }
    },
    "manual.agent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent tools: server_list lists configured servers; server_status returns a metrics summary; server_processes lists top processes (read-only). server_container lists or starts/stops/restarts containers; server_exec runs a command. Write operations are high risk and always require explicit user approval, even in autonomous mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 工具：server_list 列出已配置的服务器；server_status 返回指标摘要；server_processes 列出高占用进程（只读）。server_container 查看或启动/停止/重启容器；server_exec 执行命令。写操作为高风险，始终需要用户显式批准，自主模式下也不例外。"
          }
        }
      }
    },
    "manual.security": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security: the plugin is disabled by default; enable it in Plugin Management. Disabling immediately withdraws its Agent tools. All SSH sessions use BatchMode with connect and keepalive timeouts. Container names and process IDs are validated before any action; remote scripts are constants with no user-input interpolation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全：插件默认禁用，需在插件管理中启用。禁用时会立即撤回其 Agent 工具。所有 SSH 会话使用 BatchMode，并带连接与保活超时。容器名与进程 ID 在执行动作前都会校验；远端脚本为常量，不拼接用户输入。"
          }
        }
      }
    },
