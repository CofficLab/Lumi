    "Describe the screen in words and the Agent writes the layout for you." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe the screen in words and the Agent writes the layout for you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用几句话描述这一屏，Agent 会替你写出布局。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用幾句話描述這個畫面，Agent 會替你寫出佈局。"
