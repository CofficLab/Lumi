    "Captured HTML is truncated; read the current screen HTML before editing." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captured HTML is truncated; read the current screen HTML before editing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捕获的 HTML 已截断；编辑前请读取当前屏幕的 HTML。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取的 HTML 已截斷；編輯前請讀取目前畫面的 HTML。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取的 HTML 已截斷；編輯前請讀取目前畫面的 HTML。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擷取的 HTML 已截斷；編輯前請讀取目前畫面的 HTML。"
          }
        }
      }
    },
    "Changing the device canvas re-renders existing screens at the new size; check the preview afterwards." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing the device canvas re-renders existing screens at the new size; check the preview afterwards."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更换设备画板会以新尺寸重新渲染已有屏幕，之后请检查预览。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更換裝置畫板會以新尺寸重新算繪已有畫面，之後請檢查預覽。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更換裝置畫板會以新尺寸重新算繪已有畫面，之後請檢查預覽。"
          }
        }
      }
    },
    "Chat with the Agent to sketch product prototypes as connected HTML screens." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat with the Agent to sketch product prototypes as connected HTML screens."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和 Agent 聊天，用互相连接的 HTML 屏幕勾勒产品原型。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和 Agent 聊天，用互相連結的 HTML 畫面勾勒產品原型。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和 Agent 聊天，用互相連結的 HTML 畫面勾勒產品原型。"
          }
        }
      }
    },
    "Click Export and choose a folder." : {
