    "Ask the Agent to create a prototype." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the Agent to create a prototype."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Agent 创建一个原型项目。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
