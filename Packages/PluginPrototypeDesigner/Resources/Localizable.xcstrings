    },
    "Ask the Agent to link a control to another screen, e.g. \"make the primary button go to the detail screen\"." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the Agent to link a control to another screen, e.g. \"make the primary button go to the detail screen\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Agent 把某个控件连到另一屏，例如「让主按钮跳到详情页」。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓 Agent 把某個控件連到另一個畫面，例如「讓主按鈕跳到詳情頁」。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓 Agent 把某個控件連到另一個畫面，例如「讓主按鈕跳到詳情頁」。"
          }
        }
      }
    },
