    "Describe your app and what to highlight in the chat, e.g. \"a promo image for a coffee tracker, highlight the brew timer\"." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe your app and what to highlight in the chat, e.g. \"a promo image for a coffee tracker, highlight the brew timer\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在聊天中描述应用与要突出的内容,例如「为一个咖啡记录应用创建宣传图,突出冲煮计时功能」。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在聊天中描述應用程式與要突出的內容,例如「為一個咖啡記錄應用程式建立宣傳圖,突出沖煮計時功能」。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在聊天中描述應用程式與要突出的內容,例如「為一個咖啡記錄應用程式建立宣傳圖,突出沖煮計時功能」。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
