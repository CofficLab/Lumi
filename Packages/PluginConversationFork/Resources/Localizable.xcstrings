    "A summary of this conversation will be generated and sent as the first message in a new chat. The current conversation stays unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A summary of this conversation will be generated and sent as the first message in a new chat. The current conversation stays unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将生成当前对话的摘要，并作为新对话的首条消息发送。当前对话保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將產生目前對話的摘要，並作為新對話的首條訊息傳送。目前對話保持不變。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將產生目前對話的摘要，並作為新對話的首條訊息傳送。目前對話保持不變。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將產生目前對話的摘要，並作為新對話的首條訊息傳送。目前對話保持不變。"
          }
        }
      }
    },
