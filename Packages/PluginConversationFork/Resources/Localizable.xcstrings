    "Select a conversation first, then continue it in a new chat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a conversation first, then continue it in a new chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择一个对话，再将其续接到新对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先選擇一個對話，再將其續接到新對話。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請先選擇一個對話，再將其續接到新對話。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請先選擇一個對話，再將其續接到新對話。"
