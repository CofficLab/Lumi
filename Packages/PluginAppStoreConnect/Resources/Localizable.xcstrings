    "This manual covers the interface and basic operations of App Store Connect: configuring credentials, browsing apps and versions, managing distribution, and viewing Xcode Cloud builds." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This manual covers the interface and basic operations of App Store Connect: configuring credentials, browsing apps and versions, managing distribution, and viewing Xcode Cloud builds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本手册介绍 App Store Connect 的界面和基本操作：配置凭据、浏览应用和版本、管理发布内容，以及查看 Xcode Cloud 构建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本手冊介紹 App Store Connect 的界面和基本操作：配置憑據、瀏覽應用和版本、管理髮布內容，以及查看 Xcode Cloud 構建。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本手冊介紹 App Store Connect 的界面和基本操作：配置憑據、瀏覽應用和版本、管理髮布內容，以及查看 Xcode Cloud 構建。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本手冊介紹 App Store Connect 的界面和基本操作：配置憑據、瀏覽應用和版本、管理髮布內容，以及查看 Xcode Cloud 構建。"
          }
