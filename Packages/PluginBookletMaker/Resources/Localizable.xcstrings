    "After binding, it becomes a booklet with content on both sides. Each page is about half the size of an A4 sheet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After binding, it becomes a booklet with content on both sides. Each page is about half the size of an A4 sheet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装订后会成为一本小册子，正反面都有内容，每页约为 A4 纸的一半大小。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "裝訂後會成為一本小冊子，正反面都有內容，每頁約為 A4 紙的一半大小。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "裝訂後會成為一本小冊子，正反面都有內容，每頁約為 A4 紙的一半大小。"
          }
        }
      }
    },
