    "Adjust the margins, gutter, blank-page padding, and cut marks as needed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the margins, gutter, blank-page padding, and cut marks as needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需调整边距、装订线、空白页补齐与裁切标记。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "依需調整邊距、裝訂線、空白頁補齊與裁切標記。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "依需調整邊距、裝訂線、空白頁補齊與裁切標記。"
          }
        }
      }
    },
