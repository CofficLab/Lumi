    "Booklet pages are reordered for folding and binding; print a test sheet first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Booklet pages are reordered for folding and binding; print a test sheet first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小册子的页面会按折叠与装订需要重新排序;建议先打印一张测试。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "小冊子的頁面會按折疊與裝訂需要重新排序;建議先列印一張測試。"
          }
        },
        "zh-TW": {
