    "See your conversation rhythm over the last 30 days, 90 days, or year. The heatmap shows daily message activity while the trend chart summarizes token consumption." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your conversation rhythm over the last 30 days, 90 days, or year. The heatmap shows daily message activity while the trend chart summarizes token consumption."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看最近 30 天、90 天或一年的会话节奏。热力图展示每日消息活动，趋势图汇总 Token 消耗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看最近 30 天、90 天或一年的對話節奏。熱力圖展示每日訊息活動，趨勢圖匯總 Token 消耗。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看最近 30 天、90 天或一年的對話節奏。熱力圖展示每日訊息活動，趨勢圖匯總 Token 消耗。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看最近 30 天、90 天或一年的對話節奏。熱力圖展示每日訊息活動，趨勢圖匯總 Token 消耗。"
          }
        }
      }
    },
