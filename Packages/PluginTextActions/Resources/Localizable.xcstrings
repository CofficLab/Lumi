    "Grant accessibility permission when prompted, using Open System Settings if necessary.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant accessibility permission when prompted, using Open System Settings if necessary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据提示授予辅助功能权限,必要时可点击「打开系统设置」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依提示授予輔助使用權限,必要時可點擊「打開系統設定」。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "依提示授予輔助使用權限,必要時可點擊「打開系統設定」。"
