    "Accessibility permission is required to read selected text from other apps.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取其他应用的选中文字需要辅助功能权限。"
          }
        }
      }
    },
    "Accessibility permission not granted": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授予辅助功能权限"
          }
        }
      }
    },
    "After text is selected in another app, a floating menu with Copy, Search, and Translate appears near the selection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After text is selected in another app, a floating menu with Copy, Search, and Translate appears near the selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他应用中选中文本后,选区附近会出现包含「拷贝」「搜索」「翻译」的浮层菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他應用程式中選取文字後,選區附近會出現包含「拷貝」「搜尋」「翻譯」的浮層選單。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他應用程式中選取文字後,選區附近會出現包含「拷貝」「搜尋」「翻譯」的浮層選單。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他應用程式中選取文字後,選區附近會出現包含「拷貝」「搜尋」「翻譯」的浮層選單。"
          }
        }
      }
    },
