    "A clean transcript without tool calls, reasoning, or technical metadata.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean transcript without tool calls, reasoning, or technical metadata."
