    },
    "This manual covers the Open In %@ plugin, which opens the current project or a specified path in %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This manual covers the Open In %@ plugin, which opens the current project or a specified path in %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本手册介绍 Open In %@ 插件，它可在 %@ 中打开当前项目或指定路径。"
          }
        }
      }
    },
    "Tool name: `%@` — invoke this tool in the chat to open a project.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool name: `%@` — invoke this tool in the chat to open a project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具名称：`%@` — 在聊天中调用此工具打开项目。"
          }
        }
      }
    },
    "Default target: the current project in Lumi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default target: the current project in Lumi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认目标：Lumi 中的当前项目。"
          }
        }
      }
    },
    "Optional argument: an absolute path to open a different project or folder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional argument: an absolute path to open a different project or folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选参数：用于打开其他项目或文件夹的绝对路径。"
          }
        }
      }
    },
    "Basic Operations": {
      "localizations": {
