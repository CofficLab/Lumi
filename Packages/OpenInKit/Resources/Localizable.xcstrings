    "Current Project": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current Project"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前项目"
          }
        }
      }
    },
    "Uses the open project as the default target when no path is supplied.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the open project as the default target when no path is supplied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未提供路径时，默认使用当前打开的项目。"
          }
        }
      }
    },
    "Explicit Paths": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit Paths"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指定路径"
          }
        }
      }
    },
    "Accepts an absolute path when you need to open a different project or folder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepts an absolute path when you need to open a different project or folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要打开其他项目或文件夹时，可接受绝对路径。"
