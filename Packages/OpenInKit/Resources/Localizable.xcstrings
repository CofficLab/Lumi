            "value": "A direct handoff to %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接交接到 %@"
          }
        }
      }
    },
    "Keep the project in Lumi while sending the current project or a specific absolute path to the external application.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the project in Lumi while sending the current project or a specific absolute path to the external application."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前项目或指定绝对路径发送到外部应用，同时在 Lumi 中保留项目。"
          }
        }
      }
    },
    "Core Capabilities": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core Capabilities"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
