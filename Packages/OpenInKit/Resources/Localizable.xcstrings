        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低风险操作"
          }
        }
      }
    },
    "Only asks the operating system to open the target in %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only asks the operating system to open the target in %@."
