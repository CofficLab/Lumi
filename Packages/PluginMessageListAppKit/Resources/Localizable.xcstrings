        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析问题内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解析問題內容"
          }
        }
      }
    },
