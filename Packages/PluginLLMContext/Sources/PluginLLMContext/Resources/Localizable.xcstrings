        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供应商返回上下文长度超限，Lumi 压缩后重新尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商回報上下文長度超限，Lumi 壓縮後重新嘗試。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商回報上下文長度超限，Lumi 壓縮後重新嘗試。"
