    "An emergency compaction was requested to keep the next request safe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An emergency compaction was requested to keep the next request safe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为保证下一次请求安全，执行了紧急压缩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為保證下一次請求安全，執行了緊急壓縮。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "為保證下一次請求安全，執行了緊急壓縮。"
