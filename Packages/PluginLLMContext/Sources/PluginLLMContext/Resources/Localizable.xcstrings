    "The input budget reached the hard threshold.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The input budget reached the hard threshold."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入预算达到硬阈值后进行了压缩。"
