    "Some points are estimated locally because the provider did not report usage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some points are estimated locally because the provider did not report usage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分点由本地估算，因为供应商未上报用量。"
