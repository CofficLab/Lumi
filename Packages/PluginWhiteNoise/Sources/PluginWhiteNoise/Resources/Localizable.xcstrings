        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时生成白噪音、粉噪音、棕噪音,助力专注与助眠:无音频文件、真正无缝循环、多轨自由混合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
