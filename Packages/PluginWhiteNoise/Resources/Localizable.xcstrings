    "Auto-stop after 15 / 30 / 60 minutes with a countdown.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-stop after 15 / 30 / 60 minutes with a countdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "15 / 30 / 60 分钟后自动停止,带倒计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "15 / 30 / 60 分鐘後自動停止,帶倒計時。"
          }
        }
      }
    },
