    "Real-time generated white, pink and brown noise for focus and sleep — no audio files, seamless loops, mixable tracks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real-time generated white, pink and brown noise for focus and sleep — no audio files, seamless loops, mixable tracks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时生成白噪音、粉噪音、棕噪音,助力专注与助眠:无音频文件、真正无缝循环、多轨自由混合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時生成白噪音、粉噪音、棕噪音,助力專注與助眠:無音訊檔案、真正無縫循環、多軌自由混音。"
          }
        }
      }
    },
