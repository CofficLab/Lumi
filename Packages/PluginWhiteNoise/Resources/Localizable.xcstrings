        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開關音軌、調節音量、按需設定睡眠定時。"
          }
        }
      }
    },
    "Toggle white, pink and brown noise independently and blend with per-track volume.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle white, pink and brown noise independently and blend with per-track volume."
