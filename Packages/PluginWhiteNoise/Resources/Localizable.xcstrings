    "The White Noise container appears in the ActivityBar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The White Noise container appears in the ActivityBar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏 ActivityBar 出现白噪音容器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "側邊欄 ActivityBar 出現白噪音容器。"
          }
        }
      }
    },
    "This manual covers the interface and basic operations of White Noise: playing noise tracks, adjusting volumes, and setting the sleep timer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本手册介绍白噪声的界面与基本操作：播放噪声音轨、调节音量以及设置睡眠定时器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本手册介绍白噪声的界面与基本操作：播放噪声音轨、调节音量以及设置睡眠定时器。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本手册介绍白噪声的界面与基本操作：播放噪声音轨、调节音量以及设置睡眠定时器。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本手册介绍白噪声的界面与基本操作：播放噪声音轨、调节音量以及设置睡眠定时器。"
          }
        }
      }
    },
