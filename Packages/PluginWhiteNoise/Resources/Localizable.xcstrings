          "stringUnit": {
            "state": "translated",
            "value": "白 / 粉 / 棕噪声独立开关、各自调节音量,混合输出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "白 / 粉 / 棕噪聲獨立開關、各自調節音量,混合輸出。"
          }
        }
