        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本手册介绍「数据库」的界面与基本操作:管理连接、浏览数据表、编写并运行 SQL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本手冊介紹「資料庫」的介面與基本操作:管理連線、瀏覽資料表、撰寫並執行 SQL。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
