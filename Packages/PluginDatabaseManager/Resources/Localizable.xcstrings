    "This manual covers the interface and basic operations of the Database Manager: managing connections, browsing tables, and running SQL.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This manual covers the interface and basic operations of the Database Manager: managing connections, browsing tables, and running SQL."
