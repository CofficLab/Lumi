    "Click Start in the header to start the firewall; the status badge shows the current state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Start in the header to start the firewall; the status badge shows the current state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击顶部状态栏中的「启动」启动防火墙,状态徽章会显示当前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊頂部狀態列中的「啟動」啟動防火牆,狀態徽章會顯示目前狀態。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊頂部狀態列中的「啟動」啟動防火牆,狀態徽章會顯示目前狀態。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊頂部狀態列中的「啟動」啟動防火牆,狀態徽章會顯示目前狀態。"
          }
        }
      }
    },
    "In the Apps list, turn on an app's switch to allow its network access, or turn it off to deny it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Apps list, turn on an app's switch to allow its network access, or turn it off to deny it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「应用」列表中,打开某个应用的开关允许其联网,关闭则拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「應用程式」列表中,開啟某個應用程式的開關允許其連網,關閉則拒絕。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在「應用程式」列表中,開啟某個應用程式的開關允許其連網,關閉則拒絕。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在「應用程式」列表中,開啟某個應用程式的開關允許其連網,關閉則拒絕。"
          }
        }
      }
    },
    "Review the Recent Events list to check which connections were allowed or denied.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the Recent Events list to check which connections were allowed or denied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看「最近事件」列表,了解哪些连接被允许、哪些被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視「最近事件」列表,了解哪些連線被允許、哪些被拒絕。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視「最近事件」列表,了解哪些連線被允許、哪些被拒絕。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視「最近事件」列表,了解哪些連線被允許、哪些被拒絕。"
          }
        }
      }
    },
    "Click Stop in the header when you no longer need the firewall.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Stop in the header when you no longer need the firewall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再需要防火墙时,点击顶部状态栏中的「停止」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不再需要防火牆時,點擊頂部狀態列中的「停止」。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
