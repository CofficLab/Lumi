    "When the firewall is stopped, the per-app rules are not enforced.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the firewall is stopped, the per-app rules are not enforced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防火墙停止后,各应用的网络权限规则不再生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防火牆停止後,各應用程式的網路權限規則不再生效。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "防火牆停止後,各應用程式的網路權限規則不再生效。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "防火牆停止後,各應用程式的網路權限規則不再生效。"
          }
        }
      }
    },
    "Permission changes take effect immediately while the firewall is running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission changes take effect immediately while the firewall is running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防火墙运行期间,权限修改立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防火牆運行期間,權限修改立即生效。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
