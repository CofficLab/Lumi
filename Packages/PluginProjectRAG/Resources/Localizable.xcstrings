    "Semantic code search keeps the existing RAG database and indexes projects while you are idle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Semantic code search keeps the existing RAG database and indexes projects while you are idle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语义代码搜索保留现有 RAG 数据库，并在你空闲时为项目建立索引。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語義程式碼搜尋保留現有 RAG 資料庫，並在你空閒時為專案建立索引。"
          }
        },
        "zh-HK": {
